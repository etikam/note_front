# Variables utilisées au BUILD Docker (docker compose build / up --build).
# Copier vers `.env` à la racine de ce dépôt pour fixer les valeurs passées en build args.

# FQDN du site front (règle Host Traefik dans docker-compose.yml)
PUBLIC_WEB_HOST=notes.ci.edu.gn

VITE_API_BASE_URL=https://api.notes.ci.edu.gn
VITE_API_TIMEOUT_MS=15000
VITE_THEME_MODE=light
